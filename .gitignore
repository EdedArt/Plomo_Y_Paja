# =============================================
# .gitignore para Unity - Plomo y Paja
# =============================================

# Carpetas generadas por Unity (no subir, se regeneran solas)
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/

# Asset meta datos (Unity los regenera automáticamente)
# NO borrar esta línea: los .meta sí se suben para mantener GUIDs
# *.meta   <-- NO descomentes esto

# Unity Asset Store Packages (cada uno los descarga)
[Aa]ssets/AssetStoreTools*

# Visual Studio / Rider
.vs/
.idea/
*.sln
*.csproj
*.unityproj

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Builds
*.apk
*.aab
*.unitypackage

# API Keys - NUNCA subir esto al repo
Assets/_Game/Settings/APISettings.asset
Assets/_Game/Settings/APISettings.asset.meta

# UserSettings locales (cada uno tiene los suyos)
UserSettings/

# Crash reports
crashlytics-build.properties

# API key de OpenAI (AICompanion) - NUNCA subir
Assets/StreamingAssets/openai_key.txt
Assets/StreamingAssets/openai_key.txt.meta
# El proyecto Unity vive en una subcarpeta: las rutas con "/" quedan ancladas a la raíz del repo
**/Assets/StreamingAssets/openai_key.txt
**/Assets/StreamingAssets/openai_key.txt.meta
**/Assets/_Game/Settings/APISettings.asset
**/Assets/_Game/Settings/APISettings.asset.meta



# graphify: el grafo se sube al repo, la cache no
graphify-out/cache/
graphify-out/.graphify_python
graphify-out/.graphify_root
# cache de graphify cuando se corre sobre la carpeta de Scripts
**/graphify-out/cache/
**/Assets/**/graphify-out/
**/Assets/**/graphify-out.meta
