MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1889974140}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 926587fb49e50c6488e998d0647521e8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  fade: {fileID: 784244467}
  subtitles: {fileID: 1801902518}
  voice: {fileID: 721717716}
  speaker: Wilbur
  voiceId: wilbur_bosque_01
  lineText: "El bosque de Don Lobo. Hasta los \xE1rboles parecen deberle plata."
  thoughtSituation: "Wilbur acaba de entrar al bosque de Don Lobo de noche, siguiendo
    en el barro las huellas de un lobo y de un cerdo que caminan juntos. A lo lejos
    se oye jazz de un gram\xF3fono. Un pensamiento en espa\xF1ol, noir y ambiguo,
    de como mucho 25 palabras."
  fallbackThoughts:
  - "Jazz en medio del bosque. O el Lobo tiene buen gusto\u2026 o alguien est\xE1
    celebrando algo."
  - Las huellas siguen juntas. Si lo arrastraban, se cansaron muy pronto.
  - "Un campamento entero para cobrar una deuda. Porky deb\xEDa m\xE1s que plata."
  fadeInSeconds: 1.2
  beforeLineSeconds: 0.4
  secondsPerCharacter: 0.05
  beforeThoughtSeconds: 0.5
  thoughtTimeout: 6
