    voiceId: wilbur_taxi_01
    text: "Tranquilo, amigo. No vengo a buscar problemas\u2026 vengo a buscar a mi
      hermano."
    taxista: 0
    sfx: 
  - speaker: Taxista
    voiceId: taxista_02
    text: "\xBFSu hermano? \xBFEl menor, el de la casa de paja? \u2026Ah. Ese muchacho."
    taxista: 1
    sfx: 
  - speaker: Taxista
    voiceId: taxista_03
    text: "Que Dios lo acompa\xF1e, se\xF1or. Y cuide la billetera."
    taxista: 1
    sfx: 
  - speaker: Wilbur
    voiceId: wilbur_taxi_02
    text: "Qu\xE9dese con el cambio."
    taxista: 0
    sfx: sfx_monedas
  houseLine:
    speaker: Wilbur
    voiceId: wilbur_casa_01
    text: "Porky\u2026 \xBFqu\xE9 te hicieron?"
    taxista: 0
    sfx: 
  aiThought: "Paja mojada, la puerta en el suelo\u2026 Esto no fue el viento, Wilbur.
    Alguien vino a cobrar."
  fadeInSeconds: 0.8
  driveSeconds: 9
  brakeLead: 1.4
  afterStopSeconds: 0.6
  lineGap: 0.4
  exitFadeSeconds: 0.5
  exitDriveSeconds: 7
  revealSeconds: 1.8
  curbStandYaw: 20
  aiThoughtSeconds: 5.5
  titleFadeSeconds: 0.6
  titleHoldSeconds: 2
  skipFadeSeconds: 0.4
  fallbackSecondsPerChar: 0.06
  yawLimit: 60
  pitchLimit: 30
  lookSensitivity: 2
