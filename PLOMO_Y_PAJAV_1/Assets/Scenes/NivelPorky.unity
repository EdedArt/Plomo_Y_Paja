  taxistaVoice: {fileID: 1221487271}
  wilburVoice: {fileID: 178548720}
  ambience: {fileID: 569417585}
  wipers: {fileID: 1369863519}
  taxiEngine: {fileID: 1200827377}
  ambienceId: amb_taxi_interior
  wipersId: sfx_limpiaparabrisas
  brakeId: sfx_taxi_frenar
  doorId: sfx_puerta_carro
  driveAwayId: sfx_taxi_arranca
  ambienceVolume: 0.7
  wipersVolume: 0.35
  carriedRainCutoff: 1100
  taxiLines:
  - speaker: Taxista
    voiceId: taxista_01
    text: "Hasta aqu\xED llego, se\xF1or. De esta esquina para all\xE1 es territorio
      de Don Lobo. Tenga cuidado."
    taxista: 1
    sfx: 
  - speaker: Wilbur
    voiceId: wilbur_taxi_01
    text: "Tranquilo, amigo. No vengo a buscar problemas\u2026 vengo a buscar a mi
      hermano."
    taxista: 0
    sfx: 
  - speaker: Taxista
    voiceId: taxista_02
    text: "\xBFSu hermano? \xBFEl menor, el de la casa de paja? \u2026Ah. Ese muchacho."
    taxista: 1
    sfx: 
  - speaker: Taxista
    voiceId: taxista_03
    text: "Que Dios lo acompa\xF1e, se\xF1or. Y cuide la billetera."
    taxista: 1
    sfx: 
  - speaker: Wilbur
    voiceId: wilbur_taxi_02
    text: "Qu\xE9dese con el cambio."
    taxista: 0
    sfx: sfx_monedas
  houseLine:
    speaker: Wilbur
    voiceId: wilbur_casa_01
    text: "Porky\u2026 \xBFqu\xE9 te hicieron?"
    taxista: 0
    sfx: 
  aiThought: "Paja mojada, la puerta en el suelo\u2026 Esto no fue el viento, Wilbur.
    Alguien vino a cobrar."
